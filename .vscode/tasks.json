{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Magnetares: executar desktop",
      "type": "shell",
      "command": "wails dev -s",
      "options": {
        "cwd": "${workspaceFolder}/apps/desktop",
        "env": {
          "TMP": "${userHome}/.wails-temp",
          "TEMP": "${userHome}/.wails-temp"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Magnetares: executar API",
      "type": "shell",
      "command": "go run .",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      }
    }
  ]
}

# Porta do servidor HTTP da API (padrão: 8080)
PORT=8080

# Credenciais do Turso (modo servidor centralizado)
# Se não configuradas, a API pode operar recebendo as credenciais do Turso
# via headers HTTP (X-Magnetares-Turso-URL e X-Magnetares-Turso-Token) de cada cliente.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-server-auth-token

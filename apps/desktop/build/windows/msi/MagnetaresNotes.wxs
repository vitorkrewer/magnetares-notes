<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Magnetares Notes"
    Manufacturer="Vitor Krewer"
    Version="$(var.ProductVersion)"
    UpgradeCode="8A7F3E21-4B9D-4C62-9E15-2F4A8C10B9D3"
    Scope="perMachine"
    Language="1046">

    <MajorUpgrade
      DowngradeErrorMessage="Uma versão mais recente do Magnetares Notes já está instalada neste computador."
      AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="MagnetaresAppIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="MagnetaresAppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://vitorkrewer.github.io/magnetares-notes/" />
    <Property Id="ARPHELPLINK" Value="https://github.com/vitorkrewer/magnetares-notes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Magnetares Notes" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Magnetares Notes" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainApplication" Title="Magnetares Notes" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="D1C42E8F-7290-4A3F-8B6E-19A5D8F40211">
        <File Id="MagnetaresNotesExe" Source="$(var.ExePath)" Name="Magnetares Notes.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="E49B32A1-6C77-4D81-B2A4-5F9E01C78422">
      <Shortcut
        Id="StartMenuShortcut"
        Name="Magnetares Notes"
        Description="Caderno de anotações local-first com suporte a mapas mentais, fórmulas e sincronização segura."
        Target="[INSTALLFOLDER]Magnetares Notes.exe"
        WorkingDirectory="INSTALLFOLDER"
        Icon="MagnetaresAppIcon.ico" />
      <RemoveFolder Id="CleanUpStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Magnetares\MagnetaresNotes" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="F81D9C04-2E3B-4A95-8C12-90B7E3A61533">
      <Shortcut
        Id="DesktopShortcutLink"
        Name="Magnetares Notes"
        Description="Abrir Magnetares Notes"
        Target="[INSTALLFOLDER]Magnetares Notes.exe"
        WorkingDirectory="INSTALLFOLDER"
        Icon="MagnetaresAppIcon.ico" />
      <RegistryValue Root="HKCU" Key="Software\Magnetares\MagnetaresNotes" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>

